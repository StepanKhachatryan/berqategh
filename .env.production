# Supabase connection for the deployed site.
#
# The publishable ("anon") key is designed to ship inside the browser bundle —
# it grants nothing on its own. Every table is protected by row level security
# (see supabase/migrations), so this key can only do what those policies allow:
# read live listings, and write listings belonging to its own device token.
VITE_SUPABASE_URL=https://xkcjipuabawakdcewklq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_sQpw4YMk2ma_6nK4aJzsqA_F1GcETDF
